# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================================
# CONSULPORTAL AUTOMATED EMAIL NOTIFICATION SYSTEM CONFIG
# ==========================================================
# Preferred Provider: brevo | resend | smtp | test
EMAIL_PROVIDER="brevo"

# Brevo Transactional Email API Key (xkeysib-...)
BREVO_API_KEY=""

# Alternative Resend API Key (re_...)
RESEND_API_KEY=""
EMAIL_API_KEY=""

# Sender Identity Configuration
EMAIL_FROM_EMAIL="Info@consulportal.tech"
EMAIL_FROM_NAME="ConsulPortal Consular & Visa Authority"
EMAIL_REPLY_TO="Info@consulportal.tech"
ADMIN_NOTIFICATION_EMAIL="Info@consulportal.tech"

# Email System Operation Mode
EMAIL_TEST_MODE="false"
PAYMENT_REMINDERS_ENABLED="true"

# SMTP Fallback / Direct Relay Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

